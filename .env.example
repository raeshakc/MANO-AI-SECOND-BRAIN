# Required to call NVIDIA Nemotron through Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# 'demo' = in-memory data isolated per browser session (safe public demo default)
# 'local' = persistent SQLite on ONE trusted local computer, NOT for public hosting
MANO_DATA_MODE=demo
MANO_DB_PATH=mano_private.db
MANO_TIMEZONE=America/Chicago

# Optional: approving a research proposal uses Tavily search if configured
TAVILY_API_KEY=

# Basic per-browser-session limit for publicly accessible demos (not a global cap)
MANO_MAX_CALLS_PER_SESSION=10
